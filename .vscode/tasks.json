{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "Add Path to Chezmoi",
      "command": "chezmoi",
      "args": ["add", "${input:pathToAdd}"],
      "problemMatcher": []
    },
    {
      "type": "process",
      "label": "Add Files to Chezmoi (System Picker)",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/vscode_integration/chezmoi-portal.py",
        "add"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "process",
      "label": "Forget Files from Chezmoi (System Picker)",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/vscode_integration/chezmoi-portal.py",
        "forget"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      }
    }
  ],
  "inputs": [
    {
      "id": "pathToAdd",
      "type": "promptString",
      "description": "Path to the file or directory to add to chezmoi"
    }
  ]
}
