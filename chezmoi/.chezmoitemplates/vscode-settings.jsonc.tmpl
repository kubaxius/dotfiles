{
  // =========================
  // TODO / FIXME / BUG highlighting (all languages)
  // =========================
  "todo-tree.highlights.enabled": true,
  "todo-tree.highlights.useColourScheme": false,
  "todo-tree.highlights.defaultHighlight": {
    "foreground": "#ffffff",
    "background": "#444444",
    "fontStyle": "bold"
  },

  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "foreground": "#ffffff",
      "background": "#44ff1ea1",
      "fontStyle": "bold"
    },
    "FIXME": {
      "foreground": "#ffffff",
      "background": "#d73a49",
      "fontStyle": "bold"
    },
    "BUG": {
      "foreground": "#000000",
      "background": "#f2cc60",
      "fontStyle": "bold"
    },
    "NOTE": {
      "foreground": "#000000",
      "background": "#7ee787",
      "fontStyle": "bold"
    }
  },

  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "NOTE"],

  "todo-tree.regex.regex": "(TODO|FIXME|BUG|NOTE)",

  "todo-tree.filtering.excludeGlobs": ["package-lock.json"],
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",

  // =========================
  // Explorer
  // =========================

  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "comments.openView": "never",
  // {{ if eq .profile "dotfiles" }}
  "workbench.colorTheme": "Solarized Dark",
  // {{ end }}

  // =========================
  // Global editor behavior
  // =========================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.linkedEditing": true,
  "editor.mouseWheelZoom": true,
  "editor.fontSize": 16,
  "window.controlsStyle": "hidden",
  "window.newWindowProfile": "Default",
  "editor.rulers": [80, 120],

  // =========================
  // Editor font
  // =========================

  "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
  "editor.fontLigatures": true,

  // =========================
  // Language-specific formatters
  // =========================
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.trailingComma": "none"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },

  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.inlayHints.enabled": "offUnlessPressed"
  },

  "[csharp]": {
    "editor.defaultFormatter": "muhammad-sammy.csharp"
  },

  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },

  // =========================
  // Lua debugging and libraries
  // =========================

  "Lua.workspace.library": [
    "types",
    "lib",
    "vendor",
    "/usr/share/lua/5.5",
    "/usr/share/hypr/stubs"
  ],

  "lua.debug.settings.luaVersion": "lua55",

  "lua.debug.settings.path": [
    "${workspaceFolder}/?.lua",
    "${workspaceFolder}/?/init.lua",
    "/usr/local/share/lua/5.5/?.lua",
    "/usr/local/share/lua/5.5/?/init.lua",
    "/usr/share/lua/5.5/?.lua",
    "/usr/share/lua/5.5/?/init.lua"
  ],

  "lua.debug.settings.cpath": [
    "${workspaceFolder}/?.so",
    "/usr/local/lib/lua/5.5/?.so",
    "/usr/lib/lua/5.5/?.so"
  ],

  // =========================
  // Markdown Lint rules
  // =========================

  "markdown-preview-enhanced.previewTheme": "atom-dark.css",

  // =========================
  // Terminal
  // =========================

  // defaults to editor font
  //"terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "terminal.integrated.env.linux": {
    "DISABLE_TMUX_AUTOSTART": "1"
  },
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/usr/bin/zsh"
    },
    "fish": {
      "path": "fish"
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.linux": "zsh",

  // =========================
  // Git
  // =========================
  "git.autofetch": true,
  "git.confirmSync": false,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "lmstudio:lmstudio",

  // =========================
  // Suggestions & IntelliSense
  // =========================
  "editor.quickSuggestions": {
    "strings": "on"
  },

  // =========================
  // File associations
  // =========================
  "files.associations": {
    "*.css": "tailwindcss",
    "*.astro": "astro",
    "*.astro.style": "tailwindcss",
    "grub": "shellscript",
    "dot_zshrc": "shellcheckrc"
  },

  // =========================
  // Token color customizations
  // =========================
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["storage.type.function.js", "storage.type.function.ts"],
        "settings": {
          "foreground": "#b400db",
          "fontStyle": "bold italic"
        }
      },
      {
        "scope": ["keyword.control.export", "storage.modifier.export"],
        "settings": {
          "foreground": "#00e467",
          "fontStyle": "bold"
        }
      }
    ]
  },
  // =========================
  // SVG preview
  // =========================
  "svg.preview.mode": "svg",

  // =========================
  // Tailwind + PostCSS for Astro
  // =========================
  "tailwindCSS.includeLanguages": {
    "astro": "html",
    "postcss": "css"
  },
  "css.validate": true,

  // =========================
  // AI assistants
  // =========================
  "ansible.lightspeed.enabled": false,
  "chat.agent.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "claude-history.cloudSync.enableDetailedStats": true,
  "claude-history.database.storeMessages": true,
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "acp.agents": {
    "GitHub Copilot": {
      "command": "npx",
      "args": ["@github/copilot-language-server@latest", "--acp"],
      "env": {}
    },
    "Claude Code": {
      "command": "npx",
      "args": ["@agentclientprotocol/claude-agent-acp@latest"],
      "env": {}
    },
    "Gemini CLI": {
      "command": "npx",
      "args": ["@google/gemini-cli@latest", "--experimental-acp"],
      "env": {}
    },
    "Qwen Code": {
      "command": "npx",
      "args": ["@qwen-code/qwen-code@latest", "--acp", "--experimental-skills"],
      "env": {}
    },
    "Auggie CLI": {
      "command": "npx",
      "args": ["@augmentcode/auggie@latest", "--acp"],
      "env": {
        "AUGMENT_DISABLE_AUTO_UPDATE": "1"
      }
    },
    "Qoder CLI": {
      "command": "npx",
      "args": ["@qoder-ai/qodercli@latest", "--acp"],
      "env": {}
    },
    "Codex CLI": {
      "command": "npx",
      "args": ["@zed-industries/codex-acp@latest"],
      "env": {}
    },
    "OpenCode": {
      "command": "npx",
      "args": ["opencode-ai@latest", "acp"],
      "env": {}
    },
    "OpenClaw": {
      "command": "npx",
      "args": ["openclaw", "acp"],
      "env": {}
    },
    "Kiro CLI": {
      "command": "kiro-cli",
      "args": ["acp"],
      "env": {}
    },
    "Hermes Agent": {
      "command": "hermes",
      "args": ["acp"],
      "env": {}
    },
    "OC": {
      "command": "/usr/bin/opencode",
      "args": ["acp"]
    }
  },

  // =========================
  // JSON and YAML schemas
  // =========================
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  "yaml.schemas": {
    "file:///home/kubaxius/.vscode/extensions/continue.continue-2.0.0-linux-x64/config-yaml-schema.json": [
      ".continue/**/*.yaml"
    ]
  },

  // =========================
  // Language tooling
  // =========================
  "go.toolsManagement.autoUpdate": true,
  "cSpell.userWords": ["rebuildable"],

  // =========================
  // Privacy and security
  // =========================
  "telemetry.telemetryLevel": "off",
  "security.workspace.trust.untrustedFiles": "open",

  // =========================
  // SQL Tools
  // =========================
  "sqltools.useNodeRuntime": true
}
