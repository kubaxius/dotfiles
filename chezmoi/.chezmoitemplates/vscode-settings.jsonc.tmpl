{
  // =========================
  // TODO / FIXME / BUG highlighting (all languages)
  // =========================
  "todo-tree.highlights.enabled": true,
  "todo-tree.highlights.useColourScheme": false,
  "todo-tree.highlights.defaultHighlight": {
    "foreground": "#ffffff",
    "background": "#444444",
    "fontStyle": "bold"
  },

  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "foreground": "#ffffff",
      "background": "#44ff1ea1",
      "fontStyle": "bold"
    },
    "FIXME": {
      "foreground": "#ffffff",
      "background": "#d73a49",
      "fontStyle": "bold"
    },
    "BUG": {
      "foreground": "#000000",
      "background": "#f2cc60",
      "fontStyle": "bold"
    },
    "NOTE": {
      "foreground": "#000000",
      "background": "#7ee787",
      "fontStyle": "bold"
    }
  },

  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "NOTE"],

  "todo-tree.regex.regex": "(TODO|FIXME|BUG|NOTE)",

  "todo-tree.filtering.excludeGlobs": ["package-lock.json"],
  "todo-tree.ripgrep.ripgrep": "/usr/bin/rg",

  // =========================
  // Explorer
  // =========================

  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",

  // =========================
  // Global editor behavior
  // =========================
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.linkedEditing": true,
  "editor.mouseWheelZoom": true,
  "window.controlsStyle": "hidden",

  // =========================
  // Editor font
  // =========================

  "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
  "editor.fontLigatures": true,

  // =========================
  // Language-specific formatters
  // =========================
  "[astro]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "prettier.trailingComma": "none"
  },
  "[svg]": {
    "editor.defaultFormatter": "jock.svg"
  },

  "[python]": {
    "editor.defaultFormatter": "mikoz.black-py"
  },

  "[csharp]": {
    "editor.defaultFormatter": "muhammad-sammy.csharp"
  },

  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua"
  },

  // =========================
  // Lua debugging and libraries
  // =========================

  "Lua.workspace.library": [
    "types",
    "lib",
    "vendor",
    "/usr/share/lua/5.5",
    "/usr/share/hypr/stubs"
  ],

"lua.debug.settings.luaVersion": "lua55",

"lua.debug.settings.path": [
  "${workspaceFolder}/?.lua",
  "${workspaceFolder}/?/init.lua",
  "/usr/local/share/lua/5.5/?.lua",
  "/usr/local/share/lua/5.5/?/init.lua",
  "/usr/share/lua/5.5/?.lua",
  "/usr/share/lua/5.5/?/init.lua"
],

"lua.debug.settings.cpath": [
  "${workspaceFolder}/?.so",
  "/usr/local/lib/lua/5.5/?.so",
  "/usr/lib/lua/5.5/?.so"
],

  // =========================
  // Markdown Lint rules
  // =========================

  "markdownlint.config": {
    "MD024": {
      "siblings_only": true
    }
  },

  // =========================
  // Terminal
  // =========================

  // defaults to editor font
  //"terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', monospace",
  "terminal.integrated.env.linux": {},

  // =========================
  // Git
  // =========================
  "git.autofetch": true,
  "git.confirmSync": false,

  // =========================
  // Suggestions & IntelliSense
  // =========================
  "editor.quickSuggestions": {
    "strings": "on"
  },

  // =========================
  // File associations
  // =========================
  "files.associations": {
    "*.css": "tailwindcss",
    "*.astro": "astro",
    "*.astro.style": "tailwindcss",
    "grub": "shellscript",
    "dot_zshrc": "shellcheckrc"
  },

  // =========================
  // Token color customizations
  // =========================
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": ["storage.type.function.js", "storage.type.function.ts"],
        "settings": {
          "foreground": "#b400db",
          "fontStyle": "bold italic"
        }
      },
      {
        "scope": ["keyword.control.export", "storage.modifier.export"],
        "settings": {
          "foreground": "#00e467",
          "fontStyle": "bold"
        }
      }
    ]
  },
  // =========================
  // SVG preview
  // =========================
  "svg.preview.mode": "svg",

  // =========================
  // Tailwind + PostCSS for Astro
  // =========================
  "tailwindCSS.includeLanguages": {
    "astro": "html",
    "postcss": "css"
  },
  "css.validate": true,
  "chat.agent.enabled": false,
  "telemetry.telemetryLevel": "off",
  "claude-history.cloudSync.enableDetailedStats": true,
  "claude-history.database.storeMessages": true,
  "security.workspace.trust.untrustedFiles": "open",
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://raw.githubusercontent.com": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  },
  "comments.openView": "never",
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/usr/bin/zsh"
    },
    "fish": {
      "path": "fish"
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux"
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.linux": "zsh",
  "editor.fontSize": 16,
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "chat.viewSessions.orientation": "stacked",
  "go.toolsManagement.autoUpdate": true,
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "lmstudio:lmstudio",
  "github.copilot.nextEditSuggestions.eagerness": "low",
  "window.newWindowProfile": "Default",
{{- if eq .profile "dotfiles" }}
  "workbench.colorTheme": "Solarized Dark",
{{- end }}
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  }
}
