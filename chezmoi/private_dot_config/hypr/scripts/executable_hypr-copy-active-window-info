#!/usr/bin/env bash

set -euo pipefail

require_command() {
	local command="$1"

	if ! command -v "$command" >/dev/null 2>&1; then
		notify-send "Active window info" "$command not found"
		exit 1
	fi
}

require_command hyprctl
require_command jq
require_command notify-send
require_command wl-copy

window_json="$(hyprctl -j activewindow)"

info="$(
	jq -r '
		def field(name; value):
			"\(name): \(value // "")";

		def display_server:
			if .xwayland == true then
				"uses Xwayland"
			else
				"uses wayland"
			end;

		[
			field("class"; .class),
			field("title"; .title),
			field("workspace"; .workspace.name),
			field("contentType"; .contentType),
			field("displayServer"; display_server)
		]
		| join("\n")
	' <<< "$window_json"
)"

printf '%s' "$info" | wl-copy
notify-send "Active window info copied" "$info"
