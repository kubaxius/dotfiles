[Desktop Entry]
Name=Steam
Comment=Application for managing and playing games on Steam
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled %U
Icon=steam
Terminal=false
Type=Application
Categories=Network;FileTransfer;Game;
MimeType=x-scheme-handler/steam;x-scheme-handler/steamlink;
Actions=Store;Community;Library;Servers;Screenshots;News;Settings;BigPicture;Friends;
PrefersNonDefaultGPU=true
X-KDE-RunOnDiscreteGpu=true

[Desktop Action Store]
Name=Store
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://store

[Desktop Action Community]
Name=Community
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://url/CommunityHome/

[Desktop Action Library]
Name=Library
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://open/games

[Desktop Action Servers]
Name=Servers
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://open/servers

[Desktop Action Screenshots]
Name=Screenshots
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://open/screenshots

[Desktop Action News]
Name=News
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://openurl/https://store.steampowered.com/news

[Desktop Action Settings]
Name=Settings
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://open/settings

[Desktop Action BigPicture]
Name=Big Picture
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://open/bigpicture

[Desktop Action Friends]
Name=Friends
Exec={{ .chezmoi.homeDir }}/.local/bin/steam-scaled steam://open/friends
